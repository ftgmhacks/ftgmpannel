rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isAdmin() { return isSignedIn() && uid() == 'Q0NoYuEprlW6SvvOrv7lnx5kSeg1'; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function changed(f) { return incoming()[f] != existing()[f]; }

    // ---------- USERS ----------
    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && uid() == userId);

      allow create: if isAdmin() || (
        isSignedIn() && uid() == userId
        && incoming().wallet == 0
        && incoming().role == 'user'
        && incoming().status == 'active'
        && incoming().uid == userId
        && incoming().email == request.auth.token.email
      );

      // Users can spend balance (decrease) OR credit verified Flux Pay session when linked to a verified flux payment
      allow update: if isAdmin() || (
        isSignedIn() && uid() == userId
        && !changed('role') && !changed('status') && !changed('uid') && !changed('email')
        && incoming().wallet is number
        && incoming().wallet >= 0
        && (
          incoming().wallet <= existing().wallet
          || (incoming().lastFluxPaymentId is string && incoming().lastFluxPaymentId != existing().get('lastFluxPaymentId', ''))
        )
      );

      allow delete: if isAdmin();
    }

    // ---------- ORDERS ----------
    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && existing().userId == uid());
      allow create: if isAdmin() || (
        isSignedIn()
        && incoming().userId == uid()
        && incoming().price is number && incoming().price >= 0
        && incoming().status in ['Pending', 'Pending (Manual)', 'Completed']
      );
      allow update: if isAdmin() || (
        isSignedIn() && existing().userId == uid()
        && !changed('userId') && !changed('price') && !changed('quantity') && !changed('serviceId')
      );
      allow delete: if isAdmin();
    }

    // ----------WALLET TRANSACTIONS ----------
    match /walletTransactions/{trxId} {
      allow read: if isAdmin() || (isSignedIn() && existing().userId == uid());
      allow create: if isAdmin() || (
        isSignedIn() && incoming().userId == uid()
        && incoming().amount is number
        && (incoming().amount <= 0 || incoming().type == 'flux_auto_deposit')
      );
      allow update, delete: if isAdmin();
    }

    // ---------- PAYMENTS ----------
    match /payments/{payId} {
      allow read: if isAdmin() || (isSignedIn() && existing().userId == uid());
      allow create: if isSignedIn()
        && incoming().userId == uid()
        && incoming().status in ['Pending', 'Approved']
        && incoming().amount is number && incoming().amount > 0;
      allow update: if isAdmin() || (
        isSignedIn() && existing().userId == uid()
        && existing().gateway == 'flux_pay'
        && incoming().status in ['Approved', 'Failed', 'Expired']
      );
      allow delete: if isAdmin();
    }

    // ---------- CATALOG (Public Read for Guest Dashboard Exploration) ----------
    match /categories/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /services/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /manualServices/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /paymentMethods/{id}  { allow read: if true; allow write: if isAdmin(); }

    // ---------- SETTINGS ----------
    match /settings/security  { allow read, write: if isAdmin(); }
    match /settings/fluxConfig { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /settings/{docId}   { allow read: if true; allow write: if isAdmin(); }

    match /{document=**} { allow read, write: if false; }
  }
}
